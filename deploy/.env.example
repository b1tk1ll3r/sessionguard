# SessionGuard stack behind Caddy Sentinel – see docs/SENTINEL.md.
# Generate every secret with: openssl rand -hex 32

# Images (prefer a fixed version tag over latest)
SESSIONGUARD_IMAGE=ghcr.io/b1tk1ll3r/sessionguard:latest
SESSIONGUARD_GUAC_IMAGE=ghcr.io/b1tk1ll3r/sessionguard-guacamole:latest
POSTGRES_VERSION=17
GUACAMOLE_VERSION=1.6.0

# Host ports (bound to 127.0.0.1 only; Caddy Sentinel proxies to them)
SESSIONGUARD_MASTER_PORT=8080
GUACAMOLE_PORT=8081

# Issuer host name of the Sentinel OIDC server. Docker maps it to the host
# so the Master reaches Caddy Sentinel even without internal DNS.
SENTINEL_ISSUER_HOST=sso.example.org

# Databases
SESSIONGUARD_DB_NAME=sessionguard
SESSIONGUARD_DB_USER=sessionguard
SESSIONGUARD_DB_PASSWORD=
GUAC_DB_NAME=guacamole_db
GUAC_DB_USER=guacamole_user
GUAC_DB_PASSWORD=

# IdP username (Sentinel: preferred_username = sAMAccountName in lower case)
# of the first Guacamole administrator; replaces "guacadmin" on a NEW database.
GUAC_ADMIN_USER=

# SessionGuard secrets
SESSIONGUARD_ENROLLMENT_TOKEN=
SESSIONGUARD_BROKER_API_KEY=
# Client secrets of the two Sentinel OIDC applications (shown once when the
# application is created in Sentinel)
SESSIONGUARD_OIDC_CLIENT_SECRET=
SESSIONGUARD_ACCESS_OIDC_CLIENT_SECRET=
# Shared secret Caddy Sentinel sends to Guacamole after forward_auth. The same
# value goes into Caddy's environment (see Caddyfile.sentinel).
SESSIONGUARD_PROXY_SECRET=

SESSIONGUARD_ALERT_WEBHOOK_URL=
