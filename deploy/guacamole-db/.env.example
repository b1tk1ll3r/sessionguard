# Guacamole-Datenbank (internes Netz)

GUACAMOLE_VERSION=1.6.0
POSTGRES_VERSION=17

# LAN-IP dieses Hosts, auf der PostgreSQL lauscht (nicht 0.0.0.0)
GUAC_DB_BIND=10.0.20.11

GUAC_DB_NAME=guacamole_db
GUAC_DB_USER=guacamole_user
# Derselbe Wert in worker/.env
GUAC_DB_PASSWORD=

# AD-Benutzername (sAMAccountName, Kleinbuchstaben) des ersten Guacamole-Admins.
# Ersetzt "guacadmin" – nur bei einer NEUEN Datenbank.
GUAC_ADMIN_USER=
