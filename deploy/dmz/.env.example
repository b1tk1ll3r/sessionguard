# SessionGuard – DMZ-Host. Secrets erzeugen mit: openssl rand -hex 32

SESSIONGUARD_IMAGE=ghcr.io/b1tk1ll3r/sessionguard:0.7.0
POSTGRES_VERSION=17

# Port des Masters auf 127.0.0.1 (muss zum Caddyfile passen)
SESSIONGUARD_MASTER_PORT=18080

# Hostname der Sentinel-Anmelde-Adresse (Issuer)
SENTINEL_ISSUER_HOST=sso.example.org

SESSIONGUARD_DB_NAME=sessionguard
SESSIONGUARD_DB_USER=sessionguard
SESSIONGUARD_DB_PASSWORD=

# Agent → Master (Erstregistrierung der RDS-Hosts)
SESSIONGUARD_ENROLLMENT_TOKEN=
# Guacamole-Worker → Master (Broker). Derselbe Wert in worker/.env
SESSIONGUARD_BROKER_API_KEY=
# Client-Secrets der Sentinel-Anwendungen sessionguard-admin und sessionguard-access
SESSIONGUARD_OIDC_CLIENT_SECRET=
SESSIONGUARD_ACCESS_OIDC_CLIENT_SECRET=

SESSIONGUARD_ALERT_WEBHOOK_URL=
