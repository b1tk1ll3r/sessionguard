# Guacamole-Worker (internes Netz) – je Worker-Host eine .env

SESSIONGUARD_GUAC_IMAGE=ghcr.io/b1tk1ll3r/sessionguard-guacamole:0.7.0
GUACAMOLE_VERSION=1.6.0
GUACD_LOG_LEVEL=info

# LAN-IP dieses Worker-Hosts, auf der Guacamole lauscht (nicht 0.0.0.0)
GUACAMOLE_BIND=10.0.20.11
GUACAMOLE_PORT=18080

# Master über Caddy Sentinel in der DMZ. Das interne DNS muss den Namen auf
# den DMZ-Host auflösen.
SESSIONGUARD_MASTER_URL=https://sessionguard.example.org
# Derselbe Wert wie in dmz/.env
SESSIONGUARD_BROKER_API_KEY=

# Guacamole-Datenbank (guacamole-db)
GUAC_DB_HOST=10.0.20.11
GUAC_DB_NAME=guacamole_db
GUAC_DB_USER=guacamole_user
GUAC_DB_PASSWORD=

# Derselbe Wert wie /etc/caddy/sessionguard-proxy.secret auf dem DMZ-Host
SESSIONGUARD_PROXY_SECRET=
